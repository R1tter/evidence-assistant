{
  "name": "evidence-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p packages/core/tsconfig.build.json && tsc -p apps/api/tsconfig.build.json && tsc -p apps/mcp/tsconfig.build.json",
    "start:api": "npm run start --workspace @evidence/api",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "verify": "npm run format:check && npm run lint && npm run check:boundaries && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
