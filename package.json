{
  "name": "evidence-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "evaluate": "npm run build && tsx scripts/evaluate.ts",
    "benchmark": "npm run build && tsx scripts/benchmark.ts",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p packages/core/tsconfig.build.json && tsc -p apps/api/tsconfig.build.json && tsc -p apps/mcp/tsconfig.build.json",
    "start:api": "npm run start --workspace @evidence/api",
    "dev:web": "npm run dev --workspace @evidence/web",
    "build:web": "npm run build --workspace @evidence/web",
    "build:storybook": "storybook build --config-dir apps/web/.storybook --output-dir storybook-static",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "verify": "npm run format:check && npm run lint && npm run check:boundaries && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
